cmake_minimum_required(VERSION 3.24)

# Metadata-only completion of the pinned, locally source-built SDK. Run before
# embedding frameworks so Xcode signs their final contents, not a later mutation.
if(NOT IS_ABSOLUTE "${PODLORD_IOS_SDK_ROOT}" OR IS_SYMLINK "${PODLORD_IOS_SDK_ROOT}"
    OR NOT EXISTS "${PODLORD_IOS_SDK_ROOT}/build-inputs.txt")
    message(FATAL_ERROR "PODLORD_IOS_SDK_ROOT must be an existing source-built Podlord iOS SDK.")
endif()
file(READ "${PODLORD_IOS_SDK_ROOT}/build-inputs.txt" inputs)
foreach(version "Qt: 6.11.3" "OpenSSL: 3.5.9" "FFmpeg: 7.1.5")
    string(FIND "${inputs}" "${version}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Unexpected iOS SDK version. Required: ${version}")
    endif()
endforeach()
set(openssl_manifest "${PODLORD_IOS_SDK_ROOT}/openssl/os-dep/Apple/PrivacyInfo.xcprivacy")
if(NOT EXISTS "${openssl_manifest}")
    message(FATAL_ERROR "The pinned OpenSSL source privacy manifest is missing.")
endif()
set(frameworks)
foreach(component avcodec avformat avutil swresample swscale)
    file(GLOB variants "${PODLORD_IOS_SDK_ROOT}/qt/lib/ffmpeg/lib${component}.xcframework/*/lib${component}.framework")
    if(NOT variants)
        message(FATAL_ERROR "Installed Qt FFmpeg framework is missing: ${component}")
    endif()
    foreach(framework IN LISTS variants)
        if(IS_SYMLINK "${framework}" OR EXISTS "${framework}/_CodeSignature"
            OR NOT EXISTS "${framework}/lib${component}" OR NOT EXISTS "${framework}/Info.plist")
            message(FATAL_ERROR "Refusing to alter a signed or incomplete SDK framework: ${framework}")
        endif()
        list(APPEND frameworks "${framework}")
    endforeach()
endforeach()

file(MAKE_DIRECTORY "${PODLORD_IOS_SDK_ROOT}/ssl/share/podlord")
configure_file("${openssl_manifest}" "${PODLORD_IOS_SDK_ROOT}/ssl/share/podlord/PrivacyInfo.xcprivacy" COPYONLY)
foreach(framework IN LISTS frameworks)
    get_filename_component(name "${framework}" NAME_WE)
    if(name STREQUAL "libavformat" OR name STREQUAL "libavutil")
        set(manifest FFmpegFilePrivacy)
    else()
        set(manifest FFmpegPrivacy)
    endif()
    configure_file("${CMAKE_CURRENT_LIST_DIR}/../native/ios/${manifest}.xcprivacy" "${framework}/PrivacyInfo.xcprivacy" COPYONLY)
endforeach()
message(STATUS "Installed pinned OpenSSL and FFmpeg privacy declarations before framework embedding.")
