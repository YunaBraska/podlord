cmake_minimum_required(VERSION 3.25)
# Rebuild only the Android activity class in a caller-owned Qt 6.11.3 SDK.
set(patch_file "${CMAKE_CURRENT_LIST_DIR}/patches/qtbase-6.11.3-android-startup.diff")
file(SHA256 "${patch_file}" patch_sha)
if(NOT patch_sha STREQUAL "2654fafab502c67a009807a6e6310c1a88c160fc204ef99e258ec07ae83b3e53")
    message(FATAL_ERROR "The pinned Android startup correction has changed.")
endif()
if(NOT IS_ABSOLUTE "${QT_SDK_PREFIX}" OR NOT IS_DIRECTORY "${QT_SDK_PREFIX}")
    message(FATAL_ERROR "An existing absolute, caller-owned QT_SDK_PREFIX is required.")
endif()
file(STRINGS "${QT_SDK_PREFIX}/lib/cmake/Qt6Core/Qt6CoreConfigVersionImpl.cmake"
    qt_version REGEX "^set\\(PACKAGE_VERSION \"6[.]11[.]3\"\\)")
if(NOT qt_version)
    message(FATAL_ERROR "The Android startup correction is restricted to Qt 6.11.3.")
endif()
set(sdk_jar "${QT_SDK_PREFIX}/jar/Qt6Android.jar")
set(manifest "${QT_SDK_PREFIX}/podlord-android-startup-patch.txt")
if(NOT EXISTS "${sdk_jar}")
    message(FATAL_ERROR "The SDK has no Qt6Android.jar.")
endif()
if(EXISTS "${manifest}")
    file(READ "${manifest}" installed)
    file(SHA256 "${sdk_jar}" installed_sha)
    if(NOT installed MATCHES "Qt Android startup patch SHA256: ${patch_sha}\n"
        OR NOT installed MATCHES "Qt Android jar SHA256: ${installed_sha}\n"
        OR NOT installed MATCHES "Qt Android source SHA256: 729f4abc611fe6dce790e4ed1626a8ec50c7a1790fcf16d5c369e991b1373b9c\n")
        message(FATAL_ERROR "The Android startup correction no longer matches this SDK.")
    endif()
    message(STATUS "Verified the installed Qt Android startup correction.")
    return()
endif()
if(NOT IS_ABSOLUTE "${WORK_ROOT}" OR EXISTS "${WORK_ROOT}" OR IS_SYMLINK "${WORK_ROOT}")
    message(FATAL_ERROR "A fresh absolute WORK_ROOT is required.")
endif()
set(android_jar "${ANDROID_SDK_ROOT}/platforms/android-36/android.jar")
if(NOT IS_ABSOLUTE "${ANDROID_SDK_ROOT}" OR NOT EXISTS "${android_jar}")
    message(FATAL_ERROR "The Android 36 SDK platform is required.")
endif()
find_program(git_command git REQUIRED)
find_program(javac_command javac HINTS "$ENV{JAVA_HOME}/bin" REQUIRED)
find_program(jar_command jar HINTS "$ENV{JAVA_HOME}/bin" REQUIRED)
set(source_relative "src/android/jar/src/org/qtproject/qt/android/QtActivityBase.java")
set(source "${WORK_ROOT}/${source_relative}")
file(MAKE_DIRECTORY "${WORK_ROOT}/src/android/jar/src/org/qtproject/qt/android")
file(DOWNLOAD
    "https://raw.githubusercontent.com/qt/qtbase/v6.11.3/${source_relative}"
    "${source}" EXPECTED_HASH SHA256=58a81c858a0f60fd0baea03c015046f13d8ecf6bbfe0f1bbb2e4a5df862d1dff
    TLS_VERIFY ON TIMEOUT 120 INACTIVITY_TIMEOUT 20)
execute_process(COMMAND "${git_command}" apply --check "${patch_file}"
    WORKING_DIRECTORY "${WORK_ROOT}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${git_command}" apply "${patch_file}"
    WORKING_DIRECTORY "${WORK_ROOT}" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${source}" source_sha)
if(NOT source_sha STREQUAL "729f4abc611fe6dce790e4ed1626a8ec50c7a1790fcf16d5c369e991b1373b9c")
    message(FATAL_ERROR "The patched activity differs from the verified correction.")
endif()
if(CMAKE_HOST_WIN32)
    set(classpath "${sdk_jar};${android_jar}")
else()
    set(classpath "${sdk_jar}:${android_jar}")
endif()
file(MAKE_DIRECTORY "${WORK_ROOT}/classes")
execute_process(COMMAND "${javac_command}" -encoding UTF-8 -source 8 -target 8
    -bootclasspath "${android_jar}" -classpath "${classpath}"
    -d "${WORK_ROOT}/classes" "${source}" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${sdk_jar}" original_sha)
file(COPY_FILE "${sdk_jar}" "${WORK_ROOT}/Qt6Android.original.jar")
file(COPY_FILE "${sdk_jar}" "${WORK_ROOT}/Qt6Android.jar")
execute_process(COMMAND "${jar_command}" --update --file "${WORK_ROOT}/Qt6Android.jar"
    -C "${WORK_ROOT}/classes" . COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${WORK_ROOT}/Qt6Android.jar" fixed_jar_sha)
file(COPY_FILE "${WORK_ROOT}/Qt6Android.jar" "${sdk_jar}")
file(WRITE "${manifest}"
    "Qt version: 6.11.3\nQt Android startup patch SHA256: ${patch_sha}\nQt Android source SHA256: ${source_sha}\nQt Android original jar SHA256: ${original_sha}\nQt Android jar SHA256: ${fixed_jar_sha}\n")
message(STATUS "Installed the verified Qt Android early-recreation startup correction.")
