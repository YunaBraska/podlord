        <key>UTTypeIdentifier</key><string>berlin.yuna.podlord.kubeconfig</string>
        <key>UTTypeDescription</key><string>Kubernetes configuration</string>
        <key>UTTypeConformsTo</key><array><string>public.text</string></array>
        <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>kubeconfig</string></array></dict>
    </dict></array>
